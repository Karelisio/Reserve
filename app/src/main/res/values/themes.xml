<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: the UI is themed by Compose (Material 3 Expressive). -->
    <style name="Theme.Reserve" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen (Android 12 API, backported by core-splashscreen). -->
    <style name="Theme.Reserve.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_gauge</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimationDuration">850</item>
        <item name="postSplashScreenTheme">@style/Theme.Reserve</item>
    </style>
</resources>
